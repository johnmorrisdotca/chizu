{
  "name": "@johnmorrisdotca/chizu",
  "version": "1.3.0",
  "description": "Chizu 地図, maps for JavaScript and TypeScript: the world and 31 countries' regions from Natural Earth, named in English and Japanese, with zoom, insets, quiz helpers and a callout placer. Drawn as SVG in any page. Zero dependencies.",
  "keywords": [
    "map",
    "maps",
    "world-map",
    "svg-map",
    "natural-earth",
    "geography",
    "geography-quiz",
    "country-names",
    "japanese",
    "choropleth",
    "callouts",
    "labels",
    "leader-lines",
    "pan-zoom",
    "typescript",
    "javascript",
    "zero-dependencies",
    "browser",
    "node",
    "itsutsu"
  ],
  "homepage": "https://johnmorrisdotca.github.io/chizu/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnmorrisdotca/chizu.git"
  },
  "bugs": {
    "url": "https://github.com/johnmorrisdotca/chizu/issues"
  },
  "author": "John Morris",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    },
    "./draw": {
      "types": "./dist/draw-entry.d.ts",
      "import": "./dist/draw-entry.js",
      "default": "./dist/draw-entry.js"
    },
    "./mount": {
      "types": "./dist/mount-entry.d.ts",
      "import": "./dist/mount-entry.js",
      "default": "./dist/mount-entry.js"
    },
    "./names": {
      "types": "./dist/names-entry.d.ts",
      "import": "./dist/names-entry.js",
      "default": "./dist/names-entry.js"
    },
    "./load": {
      "types": "./dist/load-entry.d.ts",
      "import": "./dist/load-entry.js",
      "default": "./dist/load-entry.js"
    },
    "./world": {
      "types": "./dist/world-entry.d.ts",
      "import": "./dist/world-entry.js",
      "default": "./dist/world-entry.js"
    },
    "./countries/*": {
      "types": "./dist/data/countries/*.d.ts",
      "import": "./dist/data/countries/*.js",
      "default": "./dist/data/countries/*.js"
    },
    "./divisions/*": {
      "types": "./dist/data/divisions/*.d.ts",
      "import": "./dist/data/divisions/*.js",
      "default": "./dist/data/divisions/*.js"
    },
    "./features/*": {
      "types": "./dist/data/features/*.d.ts",
      "import": "./dist/data/features/*.js",
      "default": "./dist/data/features/*.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "NOTICE.md",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:package": "pnpm build && node scripts/check-package.mjs",
    "family:readme": "node scripts/family-readme.mjs",
    "check": "pnpm lint && pnpm typecheck && pnpm test",
    "prepublishOnly": "pnpm check && pnpm build",
    "site": "pnpm build && node scripts/site.mjs",
    "test:demo": "pnpm site && playwright test",
    "screenshots:readme": "pnpm site && node scripts/readme-pictures.mjs",
    "test:readme": "pnpm build && node scripts/check-readme-examples.mjs",
    "docs:make": "node scripts/docs.mjs",
    "data": "node scripts/build-data.mjs",
    "data:wikidata": "node scripts/wikidata.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@johnmorrisdotca/kuni": "1.1.0",
    "@playwright/test": "^1.63.0",
    "@types/d3-geo": "^3.1.1",
    "d3-geo": "^3.1.1",
    "eslint": "^9.0.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^5.0.0"
  },
  "packageManager": "pnpm@10.11.0"
}
